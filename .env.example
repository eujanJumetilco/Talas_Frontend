# Copy this file to .env.local for local development.
# When deploying, set the same keys in the hosting dashboard (for example Vercel > Settings > Environment Variables).
# NEXT_PUBLIC_ values are built into the site, so redeploy after changing them.

# Where the Talas backend runs. Locally: http://localhost:8080. Deployed: the backend's public https:// address.
NEXT_PUBLIC_API_URL=http://localhost:8080

# true = use the built-in sample data and never call the backend (for demos without a backend)
NEXT_PUBLIC_USE_MOCKS=false
